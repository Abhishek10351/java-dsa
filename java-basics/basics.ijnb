    {
      "id": "0f418e69-1b61-4f41-a4d4-38168e0354bd",
      "cell_type": "markdown",
      "source": "## If Else Statements",
      "metadata": {
        "language": "markdown",
        "id": "0f418e69-1b61-4f41-a4d4-38168e0354bd"
      }
    },
    {
      "id": "243690c5-f661-4542-ba36-2bda05038873",
      "cell_type": "code",
      "source": "int number = 10;\nif (number > 0) {\n    System.out.println(\"The number is positive.\");\n} else if (number < 0) {\n    System.out.println(\"The number is negative.\");\n} else {\n    System.out.println(\"The number is zero.\");\n}\n// nested if-else statements\nint score = 85;\nif (score >= 90) {\n    System.out.println(\"Grade: A\");\n} else if (score >= 80) {\n    System.out.println(\"Grade: B\");\n} else if (score >= 70) {\n    System.out.println(\"Grade: C\");\n} else if (score >= 60) {\n    System.out.println(\"Grade: D\");\n} else {\n    System.out.println(\"Grade: F\");\n}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "93546b99-31fb-4990-86cb-c0607cf182a4",
      "cell_type": "code",
      "source": "// shorthand if-else (ternary operator)\nint num = 10;\nString result = (num % 2 == 0) ? \"Even\" : \"Odd\";\nSystem.out.println(result); // Output: Even\n\n// nested ternary operator\nint number2 = 15;\nString result2 = (number2 > 0) ? \"Positive\" : (number2 < 0) ? \"Negative\" : \"Zero\";\nSystem.out.println(result2); // Output",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    }
  ]
