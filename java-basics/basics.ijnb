    {
      "id": "0fc741e1-b748-4b14-8a09-99e88fdd27cb",
      "cell_type": "code",
      "source": "// basic type casting\nint x = 10;\ndouble y = x; // automatic type casting from int to double\n\n//  these were widening conversions, \n\n\n//  narrowing conversions require explicit casting\ndouble a = 9.78;\nint b = (int) a; // explicit type casting from double to int\n",
      "metadata": {
