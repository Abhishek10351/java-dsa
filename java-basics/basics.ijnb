      "cell_type": "markdown",
      "source": "## Operators",
      "metadata": {
        "language": "markdown",
        "id": "db5e57fe-9ff1-4ae6-9eee-cf1f44c38434"
      }
    },
    {
      "id": "efb0f8c2-0d86-44d0-b132-b6f4d089550d",
      "cell_type": "code",
      "source": "// operators\nint sum = 5 + 3; // addition\nint difference = 5 - 3; // subtraction\nint product = 5 * 3; // multiplication\ndouble quotient = 5.0 / 3.0; // division\nint remainder = 5 % 3; // modulus\nint increment = 5; increment++; // increment\nint decrement = 5; decrement--; // decrement\nboolean isEqual = (5 == 3); // equality\nboolean isNotEqual = (5 != 3); // inequality\n\nboolean isGreater = (5 > 3); // greater than\nboolean isLess = (5 < 3); // less than\nboolean isGreaterOrEqual = (5 >= 3); // greater than or equal to\nboolean isLessOrEqual = (5 <= 3); // less than or equal to\n\nboolean andCondition = (5 > 3) && (5 < 10); // logical AND\nboolean orCondition = (5 > 3) || (5 < 10); // logical OR\nboolean notCondition = !(5 > 3); // logical NOT \n\n",
      "metadata": {
        "language": "java",
        "executionSummary": {
          "executionOrder": 8,
          "success": true
        }
