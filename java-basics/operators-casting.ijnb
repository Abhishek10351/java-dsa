      }
    },
    {
      "id": "1d514299-4312-47c9-8101-59b7ada70613",
      "cell_type": "code",
      "source": "Math.abs(-5);\nMath.sqrt(16);\nMath.pow(2, 3);\nMath.sin(Math.PI / 2);",
